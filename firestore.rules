rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function userDoc()   { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin()   { return signedIn() && userDoc().data.role == 'admin'; }

    // ── Users ────────────────────────────────────────────────────────────────
    // Admin accounts only; there is no public self-signup in this app.
    match /users/{userId} {
      allow read:   if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId;
      allow update, delete: if isAdmin();
    }

    // ── Events / bookings ───────────────────────────────────────────────────
    // All reads/writes to the real collection require an authenticated admin.
    // Public visitors never read or write this collection directly:
    //  - submitting a booking goes through the submitBooking Cloud Function
    //    (Admin SDK, server-side conflict check, forces status=pending)
    //  - public listing goes through the getPublicEvents Cloud Function /
    //    the /v1/events REST endpoint, which returns only public+confirmed
    //    fields with private contact/notes stripped out.
    match /events/{eventId} {
      allow read:  if isAdmin();
      allow write: if false; // writes only via Cloud Functions (Admin SDK)
    }

    // ── Venues & departments ─────────────────────────────────────────────────
    // Public read so the booking form can list options without signing in.
    match /venues/{venueId} {
      allow read:  if true;
      allow write: if isAdmin();
    }
    match /departments/{deptId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Annual observances are public reference data, not bookings or private contacts.
    match /keyIslamicEvents/{eventId} {
      function validEvent() {
        let d = request.resource.data;
        return d.keys().hasAll(['name', 'day', 'month', 'category', 'notes', 'enabled', 'priority', 'revision', 'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(['name', 'day', 'month', 'category', 'notes', 'enabled', 'priority', 'revision', 'updatedAt', 'updatedBy'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 240
          && d.name.matches('.*[^\\s].*')
          && d.day is int && d.day >= 1 && d.day <= 30
          && d.month is int && d.month >= 1 && d.month <= 12
          && d.category in ['Wiladat', 'Shahadat', 'Wafat', 'Eid', 'Ayyam-e-Aza', 'Amaal', 'Season', 'Event']
          && d.notes is string && d.notes.size() <= 2000
          && d.enabled is bool && d.priority is int && d.priority >= 0 && d.priority <= 100
          && d.revision is int && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }
      allow read: if true;
      allow create: if isAdmin() && validEvent() && request.resource.data.revision == 0;
      allow update: if isAdmin() && validEvent()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // ── Calendar settings (Hijri adjustment etc.) ───────────────────────────
    // Public read so the calendar can render correct Hijri dates for guests.
    match /calendarSettings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Audit log ────────────────────────────────────────────────────────────
    // Admin-only, and only ever written by Cloud Functions (Admin SDK).
    match /auditLog/{entryId} {
      allow read:  if isAdmin();
      allow write: if false;
    }
  }
}
