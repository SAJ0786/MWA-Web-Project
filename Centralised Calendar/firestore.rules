rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()  { return request.auth != null; }
    function userDoc()   { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    // After the owner's first Google sign-in, sessions opened with email/password lose admin rights.
    function passwordSessionAllowed() {
      return request.auth.token.firebase.sign_in_provider != 'password'
        || !exists(/databases/$(database)/documents/calendarSettings/auth)
        || get(/databases/$(database)/documents/calendarSettings/auth).data.get('passwordLoginDisabled', false) != true;
    }
    function adminEmail(){return request.auth.token.email.lower();}
    function owner(){return request.auth.token.email_verified == true && adminEmail() == 'admin@muhammadiwelfare.org.au';}
    function teamEntry(){return get(/databases/$(database)/documents/adminAllowlist/$(adminEmail()));}
    function accessActive(){return teamEntry().data.get('accessExpiresAt', null) == null || request.time < teamEntry().data.accessExpiresAt;}
    function isAdmin(){return signedIn() && userDoc().data.role == 'admin' && passwordSessionAllowed() && (owner() || (exists(/databases/$(database)/documents/adminAllowlist/$(adminEmail())) && accessActive()));}
    function hasModule(moduleId){return isAdmin() && (owner() || moduleId in teamEntry().data.get('modules', ["events-bookings", "enquiries", "calendar-management", "niaz", "volunteers", "members", "tools-automation", "maintenance", "expenses", "donations", "social-media", "speakers-reciters", "website-cms"]));}

    // ── Users ────────────────────────────────────────────────────────────────
    // users/{uid}.role is managed only by Cloud Functions (syncAdminAccess /
    // removeAdminEmail) from the adminAllowlist, so nobody can self-assign a role.
    match /users/{userId} {
      allow read:  if signedIn() && (request.auth.uid == userId || hasModule('tools-automation'));
      allow write: if false;
    }

    // ── Admin team allowlist ────────────────────────────────────────────────
    // Source of truth for who may be an admin. Admin read; writes via functions only.
    match /adminAllowlist/{email} {
      allow read:  if signedIn() && (adminEmail() == email || hasModule('tools-automation'));
      allow write: if false;
    }

    // ── Events / bookings ───────────────────────────────────────────────────
    // All reads/writes to the real collection require an authenticated admin.
    // Public visitors never read or write this collection directly:
    //  - submitting a booking goes through the submitBooking Cloud Function
    //    (Admin SDK, server-side conflict check, forces status=pending)
    //  - public listing goes through the getPublicEvents Cloud Function /
    //    the /v1/events REST endpoint, which returns only public+confirmed
    //    fields with private contact/notes stripped out.
    match /events/{eventId} {
      allow read:  if hasModule('events-bookings');
      allow write: if false; // writes only via Cloud Functions (Admin SDK)
    }

    // ── Venues & departments ─────────────────────────────────────────────────
    // Public read so the booking form can list options without signing in.
    match /venues/{venueId} {
      allow read:  if true;
      allow write: if false;
    }
    match /departments/{deptId} {
      allow read:  if true;
      allow write: if false;
    }

    // Annual observances are public reference data, not bookings or private contacts.
    match /keyIslamicEvents/{eventId} {
      allow read: if true;
      allow write: if false; // Audited changeIslamicEvent callable.
    }

    // ── Calendar settings (Hijri adjustment etc.) ───────────────────────────
    // Public read so the calendar can render correct Hijri dates for guests.
    match /calendarSettings/{docId} {
      allow read:  if true;
      // Settings writes use audited Cloud Functions / the CMS.
      allow write: if false;
    }

    match /enquiries/{path=**} { allow read, write: if false; }
    match /enquiryOutbox/{path=**} { allow read, write: if false; }
    match /_enquiryPrivate/{path=**} { allow read, write: if false; }
    match /_enquiryOAuthStates/{path=**} { allow read, write: if false; }
    match /_enquiryMailThreads/{path=**} { allow read, write: if false; }
    match /_enquiryMailMessages/{path=**} { allow read, write: if false; }
    match /_enquiryRateLimits/{path=**} { allow read, write: if false; }

    // ── Audit log ────────────────────────────────────────────────────────────
    // Admin-only, and only ever written by Cloud Functions (Admin SDK).
    match /auditLog/{entryId} {
      allow read:  if hasModule('tools-automation');
      allow write: if false;
    }
  }
}
