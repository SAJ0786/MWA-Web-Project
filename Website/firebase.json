{
  "hosting": [
    {
      "target": "website",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/booking-response",
          "function": {
            "functionId": "bookingEmailAction",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/api/**",
          "function": {
            "functionId": "websiteCmsApi",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/calendar-app/**",
          "destination": "/calendar-app/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public,max-age=31536000,immutable"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "calendar",
      "public": "calendar-redirect",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/v1/**",
          "function": {
            "functionId": "api",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "/ical",
          "function": {
            "functionId": "icalFeed",
            "region": "australia-southeast1"
          }
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "mwa-website",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log"
      ]
    }
  ]
}
